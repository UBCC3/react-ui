# Auth0 Configuration
VITE_AUTH0_DOMAIN=your_auth0_domain
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=your_auth0_audience

# API URLs
VITE_API_URL=http://localhost:8000
VITE_STORAGE_API_URL=http://localhost:8000/storage

VITE_MODE="development_OR_production"

# Path the app is served under. Both are required, and the second must be the
# first without its trailing slash.
VITE_BASE_URL="/example/"
VITE_BASE_URL_WITHOUT_SLASH="/example"

# Optional. Overrides the third-party JSmol server used by the result viewers.
# Leave unset to use the public host.
# VITE_JSMOL_SERVER_URL=
